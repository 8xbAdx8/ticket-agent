# Optional project .env: process variables win. Never commit the real .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_API_KEY=
# QwenCloud keys (sk-ws-...) require https://<region>.maas.qwencloudapi.com/compatible-mode/v1
# Example: https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1 (Singapore)
# Alibaba Cloud DashScope keys use their own regional endpoint; never mix key and endpoint.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-flash
# Optional separate embedding endpoint must match your account region.
# DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=1024
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=ticket-agent-v34-review
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_WORKSPACE_ID=
